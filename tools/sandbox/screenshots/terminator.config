# Terminator profile for the documentation screenshots: the docs' code-block
# colours (slate background, cream text), JetBrains Mono, no chrome. Used by
# take_screenshots.py with `terminator -g`.
[global_config]
  borderless = True
  geometry_hinting = True
  inactive_color_offset = 1.0
  suppress_multiple_term_dialog = True
  tab_position = hidden
  title_hide_sizetext = True
  window_state = normal
  dbus = False
[keybindings]
[profiles]
  [[default]]
    use_system_font = False
    font = JetBrains Mono 12
    allow_bold = True
    bold_is_bright = False
    use_theme_colors = False
    background_type = solid
    background_color = "#26303D"
    foreground_color = "#F3EEE8"
    # A thin bar in the muted grey of the docs' code comments.
    cursor_shape = ibeam
    cursor_blink = False
    cursor_color = "#9AA6B0"
    cursor_color_fg = False
    # The 16 ANSI colours, matched to the slate background: normal, then
    # bright (black red green yellow blue magenta cyan white).
    palette = "#1C242E:#E8837A:#A9C08C:#E3C27A:#8FB0D6:#C9A3C7:#86C5C0:#D9D4CC:#6B7785:#F29B92:#C3D6A6:#F0D493:#A9C6E6:#DDBADB:#A3DAD5:#F3EEE8"
    scrollbar_position = hidden
    scrollback_lines = 2000
    show_titlebar = False
    copy_on_selection = False
    login_shell = False
    update_records = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
